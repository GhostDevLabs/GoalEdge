# Copy to backend/.env and fill in. Never commit the real file.

# Real bookmaker odds (the-odds-api.com) — required for value / edge.
ODDS_API_KEY=your_odds_api_key
ODDS_API_REGIONS=uk
ODDS_API_MARKETS=h2h,totals
ODDS_API_CACHE_SECONDS=43200
ODDS_API_MAX_SPORTS_PER_RUN=4

# API-Football / API-Sports dashboard key (dashboard.api-football.com).
API_FOOTBALL_KEY=your_api_football_key

# Optional — leave blank for the built-in offline analyst.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional — switch live match-centre and livescore views to SportMonks.
SPORTMONKS_API_TOKEN=your_sportmonks_api_token

# Optional — competition emblems from football-data.org.
FOOTBALL_DATA_API_TOKEN=your_football_data_api_token

# Generate a unique secret before deploying anywhere real.
JWT_SECRET=generate_a_unique_secret

# Required on Vercel; SQLite cannot persist there.
DATABASE_URL=postgresql://user:password@host:5432/database
